{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Comanda ou pedido da pastelaria",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "tableNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed", "cancelled"] },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "createdAt": { "type": "number" },
        "closedAt": { "type": "number" },
        "orderType": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "syncStatus": { "type": "string" }
      },
      "required": ["id", "customerName", "status", "total"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Item do cardápio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "order": { "type": "number" },
        "inStock": { "type": "boolean" },
        "syncStatus": { "type": "string" }
      },
      "required": ["id", "name", "price", "category"]
    },
    "CategoryItem": {
      "title": "CategoryItem",
      "description": "Categoria do cardápio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" },
        "syncStatus": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Filling": {
      "title": "Filling",
      "description": "Opção ou recheio/sabor vinculado a um produto",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "inStock": { "type": "boolean" },
        "syncStatus": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "Addon": {
      "title": "Addon",
      "description": "Adicional para itens do pedido",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "order": { "type": "number" },
        "syncStatus": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "CashSession": {
      "title": "CashSession",
      "description": "Sessão de controle de caixa da pastelaria",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "openedAt": { "type": "number" },
        "closedAt": { "type": "number" },
        "initialAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "transactions": { "type": "array" },
        "syncStatus": { "type": "string" }
      },
      "required": ["id", "openedAt", "initialAmount", "status"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Coleção de pedidos e comandas em tempo real"
    },
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Itens do cardápio"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/CategoryItem" },
      "description": "Categorias de produtos"
    },
    "/fillings/{fillingId}": {
      "schema": { "$ref": "#/entities/Filling" },
      "description": "Recheios e variações de produtos"
    },
    "/addons/{addonId}": {
      "schema": { "$ref": "#/entities/Addon" },
      "description": "Adicionais e acréscimos"
    },
    "/cash_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/CashSession" },
      "description": "Sessões e transações de caixa"
    }
  }
}
